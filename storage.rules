rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() { return request.auth != null; }
    function rol() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol;
    }
    function esAdmin() { return autenticado() && rol() == 'admin'; }
    function esTecnico() { return autenticado() && rol() == 'tecnico'; }

    match /facturas/{uid}/{archivo} {
      allow read: if autenticado();
      allow create, update: if (esAdmin() || (esTecnico() && uid == request.auth.uid))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if esAdmin();
    }
  }
}
